[user]
	name = Jeusel Guillaume
	email = jeusel.guillaume@gmail.com

# Professional identity: work is hosted on gitlab.com only.
# Overrides user.email with the renewex one (see ~/.gitconfig-work).
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
	path = ~/.gitconfig-work

[core]
	editor = nvim
	ignorecase = false

[merge]
	tool = vimdiff
	# conflict markers with a 3rd section showing the common ancestor
	conflictstyle = zdiff3
[mergetool]
	prompt = false
	# don't litter *.orig backup files after resolving conflicts
	keepBackup = false
[mergetool "vimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c '$wincmd w' -c 'wincmd J'

[difftool]
	prompt=false
[diff "sopsdiffer"]
	textconv = sops -d

[pull]
	rebase = false

[rebase]
	# auto stash/unstash uncommitted changes around a rebase
	autostash = true

[rerere]
	# remember how conflicts were resolved and replay the resolution if seen again
	enabled = true

[branch]
	# `git branch` sorted by most recent commit instead of alphabetically
	sort = -committerdate

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[alias]
    # `git log` with patches shown with difftastic.
    dl = -c diff.external=difft log -p --ext-diff

    # Show the most recent commit with difftastic.
    ds = -c diff.external=difft show --ext-diff

    # `git diff` with difftastic.
    dft = -c diff.external=difft diff

[diff]
	tool = vimdiff
	# slower but more readable hunks than the default myers algorithm
	algorithm = histogram

# [diff]
# 	tool = difftastic
# 	external = difft

[difftool "vimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"

[difftool "difftastic"]
	cmd = difft --display inline --color always "$LOCAL" "$REMOTE"
