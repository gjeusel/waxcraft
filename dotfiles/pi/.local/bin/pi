#!/bin/sh
set -eu

# Let pi-claude-bridge use Claude Code's claude.ai OAuth session. Claude Code
# otherwise prefers the shell's API key over its existing subscription login.
unset ANTHROPIC_API_KEY

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
launcher="$agent_dir/extensions/pi-safety/launcher.ts"
node_bin=${PI_SAFETY_NODE:-"$(command -v node)"}

if [ ! -f "$launcher" ]; then
  echo "pi-safety: launcher module is missing: $launcher" >&2
  echo "Run 'just pi-safety-setup' from the waxcraft repository." >&2
  exit 1
fi

exec "$node_bin" --disable-warning=ExperimentalWarning --experimental-strip-types "$launcher" "$@"
