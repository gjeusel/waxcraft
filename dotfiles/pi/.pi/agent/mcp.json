{
  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "pappers": {
      "url": "https://mcp.pappers.fr",
      "headers": {
        "Authorization": "Bearer ${PAPPERS_API_KEY}"
      }
    },
    "logfire": {
      "url": "https://logfire-eu.pydantic.dev/mcp"
    },
    "brandfetch": {
      "url": "https://mcp.brandfetch.io/mcp"
    },
    "plain": {
      "url": "https://mcp.plain.com/mcp"
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--with",
        "mcp[cli]==1.29.0",
        "postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://postgres@localhost:5432/zefire"
      }
    },
    "aws": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.7.0",
        "https://aws-mcp.eu-central-1.api.aws/mcp",
        "--profile",
        "rnx-readonly",
        "--read-only",
        "--metadata",
        "AWS_REGION=eu-west-1"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "greptile": {
      "url": "https://api.greptile.com/mcp"
    },
    "excalidraw": {
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_MCP_TOKEN}"
      }
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "imagekit-dam": {
      "url": "https://imagekit.io/mcp/dam"
    },
    "imagekit-admin": {
      "url": "https://imagekit.io/mcp/admin"
    },
    "auth0": {
      "command": "npx",
      "args": [
        "-y",
        "@auth0/auth0-mcp-server",
        "run"
      ],
      "enabled": false
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": false
    },
    "newrelic": {
      "url": "https://mcp.eu.newrelic.com/mcp/",
      "enabled": false
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    }
  }
}
