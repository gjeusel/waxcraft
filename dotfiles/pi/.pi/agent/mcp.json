{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "gmail": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "auth": "oauth"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth"
    },
    "pappers": {
      "url": "https://mcp.pappers.fr/${PAPPERS_API_KEY}"
    },
    "logfire": {
      "url": "https://logfire-eu.pydantic.dev/mcp",
      "auth": "oauth"
    },
    "postgres": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "postgres-mcp", "--access-mode=unrestricted"],
      "env": {
        "DATABASE_URI": "postgresql://postgres@localhost:5432/zefire"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "GitLab": {
      "url": "https://gitlab.com/api/v4/mcp",
      "disabled": true
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "disabled": true
    },
    "excalidraw": {
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_MCP_TOKEN}"
      }
    }
  }
}
