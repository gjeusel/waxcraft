{
  // Files in denyRead are also denied for writes. denyWrite is for paths that
  // may be read but must remain immutable. Paths must start with / or ~/.
  "filesystem": {
    "denyRead": [
      // Credential stores and tool-specific authentication files migrated from the former permissions.json policy.
      "~/**/*.env*",
      "~/**/*.tfvars",
      "~/**/.ssh/**",
      "~/**/.aws/**",
      "~/**/.gnupg/**",
      "~/**/.kube/**",
      "~/**/.netrc",
      "~/**/.npmrc",
      "~/**/.pypirc",
      "~/**/.git-credentials",
      "~/**/.docker/config.json",
      "~/**/.password-store/**",
      "~/.config/gcloud/**",
      "~/.config/gh/hosts.yml",
      "~/.config/glab-cli/**",
      "~/.claude.json",
      "~/.claude/.credentials.json",
      "~/.config/opencode/auth.json",
      "~/.config/renewex.yaml",

      // Private keys and certificate bundles can live outside the standard credential directories.
      "~/**/*.p12",
      "~/**/*.pfx",
      "~/**/id_rsa*",
      "~/**/id_ed25519*",
      "~/**/id_ecdsa*",

      // Shell, REPL, database, navigation, and AI-assistant histories.
      "~/.*history*",
      "~/.config/**/*history*",
      "~/.cache/**/*history*",
      "~/.local/share/**/*history*",
      "~/.local/state/**/*history*",
      "~/.config/zsh/.zsh_sessions/**",
      "~/.lesshst",
      "~/.local/share/atuin/**",
      "~/.local/share/zoxide/db.zo",

      // Browser profiles expose browsing, search, download, bookmark,
      // autofill, and account metadata even when tokens are redacted.
      "~/Library/Safari/**",
      "~/Library/Application Support/BraveSoftware/Brave-Browser/**",
      "~/Library/Application Support/Google/Chrome/**",
      "~/Library/Application Support/Chromium/**",
      "~/Library/Application Support/Firefox/Profiles/**",

      // Local communications and personal-information databases.
      "~/Library/Keychains/**",
      "~/Library/Mail/**",
      "~/Library/Messages/**",
      "~/Library/Calendars/**",
      "~/Library/Application Support/AddressBook/**",
      "~/Library/Group Containers/group.com.apple.notes/**",
      "~/Library/Application Support/Mimestream/**",
      "~/Library/Containers/com.mimestream.Mimestream/**",
      "~/Library/Containers/com.mimestream.Mimestream.ShareExtension/**",
      "~/Library/Group Containers/group.com.mimestream.Mimestream/**",
      "~/Pictures/Photos Library.photoslibrary/**"
    ],
    "denyWrite": []
  },

  // Rules match literal command nodes extracted by tree-sitter-bash. argv
  // predicates are exact token checks; multiple predicates are ANDed.
  "shell": {
    "deny": [
      {
        "command": "sudo",
        "reason": "sudo is reserved for direct user control"
      },
      {
        "command": "kubectl",
        "argv": {
          "containsAny": [
            "apply",
            "delete",
            "edit",
            "patch",
            "scale",
            "rollout",
            "drain",
            "cordon",
            "uncordon",
            "taint",
            "replace",
            "create",
            "set",
            "annotate",
            "label",
            "exec"
          ]
        },
        "reason": "mutating or remote-execution kubectl operation is user-controlled"
      },
      {
        "command": "helm",
        "argv": {
          "containsAny": ["install", "upgrade", "uninstall", "delete", "rollback"]
        },
        "reason": "mutating Helm operation is user-controlled"
      },
      {
        "command": "security",
        "argv": { "startsWithAny": ["find-", "dump-", "export"] },
        "reason": "macOS keychain inspection may expose credentials"
      }
    ]
  }
}
