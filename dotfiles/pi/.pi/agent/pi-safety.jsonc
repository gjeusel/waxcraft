{
  // Rules match literal command nodes extracted by tree-sitter-bash. argv
  // predicates are exact token checks; multiple predicates are ANDed.
  "shell": {
    "deny": [
      {
        "command": "sudo",
        "reason": "sudo is reserved for direct user control"
      },
      {
        "command": "kubectl",
        "argv": {
          "containsAny": [
            "apply",
            "delete",
            "edit",
            "patch",
            "scale",
            "drain",
            "cordon",
            "uncordon",
            "taint",
            "replace",
            "create",
            "set",
            "annotate",
            "label",
            "exec"
          ]
        },
        "reason": "mutating or remote-execution kubectl operation is user-controlled"
      },
      {
        "command": "kubectl",
        "argv": {
          "contains": ["rollout"],
          "containsAny": ["pause", "restart", "resume", "undo"]
        },
        "reason": "mutating kubectl rollout operation is user-controlled"
      },
      {
        "command": "helm",
        "argv": {
          "containsAny": ["install", "upgrade", "uninstall", "delete", "rollback"]
        },
        "reason": "mutating Helm operation is user-controlled"
      },
      {
        "command": "security",
        "argv": { "startsWithAny": ["find-", "dump-", "export"] },
        "reason": "macOS keychain inspection may expose credentials"
      },
      {
        "command": "gws",
        "argv": {
          "contains": ["gmail"],
          "containsAny": [
            "+send",
            "+reply",
            "+reply-all",
            "+forward",
            "send",
            "delete",
            "batchDelete",
            "trash"
          ]
        },
        "reason": "sending or deleting Gmail messages is user-controlled; only draft creation and updates are allowed"
      }
    ]
  },
  // Protected paths for the write and edit tools (Bash writes are not covered). Globs anchor at /,
  // ~/, or **/; ** spans directories, * and ? one path segment. Both the given path and its
  // symlink-resolved path are checked, so stowed files match through ~ and through the repository.
  "paths": {
    // Credentials: the home directories the rm/trash shim also refuses.
    "deny": ["~/.ssh/**", "~/.gnupg/**", "~/.aws/**", "~/.kube/**"],
    // Allowed after confirmation: this policy itself, shell startup files, and secret env files.
    "ask": [
      "**/.pi/agent/pi-safety.jsonc",
      "**/.pi/agent/extensions/pi-safety/**",
      "~/.zshrc",
      "~/.zshenv",
      "~/.zprofile",
      "~/.profile",
      "**/.env"
    ]
  },
  // /toggle-auto-mode: jev (TypeSafe) adjudicates Bash commands the rules above let through.
  // Verdicts below minConfidence are demoted to a confirmation prompt.
  "autoMode": {
    "minConfidence": 0.5
  }
}
