{
  // Rules match literal command nodes extracted by tree-sitter-bash. argv
  // predicates are exact token checks; multiple predicates are ANDed.
  "shell": {
    "deny": [
      {
        "command": "sudo",
        "reason": "sudo is reserved for direct user control"
      },
      {
        "command": "kubectl",
        "argv": {
          "containsAny": [
            "apply",
            "delete",
            "edit",
            "patch",
            "scale",
            "drain",
            "cordon",
            "uncordon",
            "taint",
            "replace",
            "create",
            "set",
            "annotate",
            "label",
            "exec"
          ]
        },
        "reason": "mutating or remote-execution kubectl operation is user-controlled"
      },
      {
        "command": "kubectl",
        "argv": {
          "contains": ["rollout"],
          "containsAny": ["pause", "restart", "resume", "undo"]
        },
        "reason": "mutating kubectl rollout operation is user-controlled"
      },
      {
        "command": "helm",
        "argv": {
          "containsAny": ["install", "upgrade", "uninstall", "delete", "rollback"]
        },
        "reason": "mutating Helm operation is user-controlled"
      },
      {
        "command": "security",
        "argv": { "startsWithAny": ["find-", "dump-", "export"] },
        "reason": "macOS keychain inspection may expose credentials"
      },
      {
        "command": "gws",
        "argv": {
          "contains": ["gmail"],
          "containsAny": [
            "+send",
            "+reply",
            "+reply-all",
            "+forward",
            "send",
            "delete",
            "batchDelete",
            "trash"
          ]
        },
        "reason": "sending or deleting Gmail messages is user-controlled; only draft creation and updates are allowed"
      }
    ]
  }
}
