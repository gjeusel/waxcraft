{
  "servers": {
    "ty": {
      "command": ["uvx", "--with", "ty==0.0.66", "ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["uvx", "--with", "ruff==0.16.1", "ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "oxfmt": {
      "command": ["oxfmt", "--lsp"],
      "extensions": [
        ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts",
        ".json", ".jsonc", ".json5", ".css", ".scss", ".less", ".pcss", ".postcss",
        ".graphql", ".gql", ".graphqls", ".toml"
      ]
    }
  }
}
