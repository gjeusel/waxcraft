{
  "lastChangelogVersion": "1.0.4",
  "theme": "nord",
  "tuiMode": "fullscreen",
  "shellPath": "/run/current-system/sw/bin/bash",
  "defaultProjectTrust": "never",
  "enableSkillCommands": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "mistral-eu/zai-glm-5-3",
    "moonshotai/kimi-k3",
    "deepseek/deepseek-flash",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1"
  ],
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "high",
    "mistral-eu/zai-glm-5-3": "high",
    "anthropic/claude-fable-5-1": "high",
    "anthropic/claude-opus-5-5": "high",
    "openai-codex/gpt-6-luna": "high",
    "openai-codex/gpt-6.1-sol": "high",
    "openai-codex/gpt-6-astra": "high"
  },
  "skills": [
    "!../../.claude/skills/synced/**",
    "~/.claude/skills",
    "~/.local/lib/node_modules/hunkdiff/skills/hunk-review/SKILL.md"
  ],
  "packages": [
    "git:github.com/paoloanzn/pi-black@v0.84.1-cc2.1.280.1",
    "npm:@tintinweb/pi-subagents@v0.19.0",
    "npm:@juicesharp/rpiv-todo@2.12.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:@narumitw/pi-lsp@0.49.9",
    "npm:pi-web-access@0.37.0",
    "git:github.com/arpagon/pi-rewind@v0.5.0",
    "npm:@ff-labs/pi-fff@0.11.0"
  ],
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "treeFilterMode": "user-only",
  "quietStartup": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "collapseChangelog": true
}