{
  "lastChangelogVersion": "0.87.0",
  "theme": "nord",
  "shellPath": "/run/current-system/sw/bin/bash",
  "defaultProjectTrust": "never",
  "enableSkillCommands": true,
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "low",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "vercel-ai-gateway/openai/gpt-5.6-sol",
    "mistral-eu/zai-glm-5-3",
    "moonshotai/kimi-k3",
    "deepseek/deepseek-flash",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1"
  ],
  "modelEffortDefaults": {
    "*flash": "high",
    "zai-glm-5-3": "high",
    "claude-fable-5-1": "high",
    "claude-opus-5-5": "high",
    "gpt-6-luna": "high",
    "gpt-6-sol": "low",
    "gpt-6-astra": "low"
  },
  "skills": [
    "!../../.claude/skills/synced/**",
    "~/.claude/skills",
    "~/.local/lib/node_modules/hunkdiff/skills/hunk-review/SKILL.md"
  ],
  "packages": [
    "npm:pi-mcp-adapter@2.32.1",
    "git:github.com/paoloanzn/pi-black@v0.84.1-cc2.1.258.1",
    "npm:@tintinweb/pi-subagents@v0.19.0",
    "npm:@juicesharp/rpiv-todo@2.10.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.8.0",
    "npm:@narumitw/pi-lsp@0.49.7",
    "npm:@narumitw/pi-codex-compact@0.52.0",
    "npm:@narumitw/pi-usage@0.60.3",
    "npm:pi-web-access@0.18.0",
    "git:github.com/arpagon/pi-rewind@v0.5.0",
    "npm:@ff-labs/pi-fff@0.10.6"
  ],
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "treeFilterMode": "user-only",
  "quietStartup": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "collapseChangelog": true
}
