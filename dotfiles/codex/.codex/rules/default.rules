# Codex execpolicy rules — auto-approve common commands.
# prefix_rule matches the command's argv prefix (exec-style, no globs):
# ["make", "format"] matches `make format ...` but not `make deploy`.
# Mirrors the allow lists in ~/.claude/settings.json and opencode.jsonc.

# ── forbidden: privilege escalation / secret-leaking commands ─────────
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["env"], decision="forbidden")
prefix_rule(pattern=["printenv"], decision="forbidden")
prefix_rule(pattern=["dotenv"], decision="forbidden")

# ── prompt: destructive / network commands ────────────────────────────
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["mv"], decision="prompt")
prefix_rule(pattern=["curl"], decision="prompt")
prefix_rule(pattern=["wget"], decision="prompt")
prefix_rule(pattern=["http"], decision="prompt")
prefix_rule(pattern=["httpx"], decision="prompt")

# ── git: read + local write ops, never push ────────────────────────────
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "blame"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "ls-tree"], decision="allow")
prefix_rule(pattern=["git", "merge-base"], decision="allow")
prefix_rule(pattern=["git", "describe"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")

# ── forges (read-mostly) ───────────────────────────────────────────────
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "pr", "status"], decision="allow")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "issue", "search"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow")
prefix_rule(pattern=["gh", "run", "list"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["gh", "search"], decision="allow")
prefix_rule(pattern=["glab", "mr"], decision="allow")
prefix_rule(pattern=["glab", "issue"], decision="allow")
prefix_rule(pattern=["glab", "api"], decision="allow")

# ── build / make ───────────────────────────────────────────────────────
prefix_rule(pattern=["make", "format"], decision="allow")
prefix_rule(pattern=["just", "format"], decision="allow")
prefix_rule(pattern=["make", "lint"], decision="allow")
prefix_rule(pattern=["just", "lint"], decision="allow")

# ── js toolchain ───────────────────────────────────────────────────────
prefix_rule(pattern=["pnpm"], decision="allow")
prefix_rule(pattern=["npm"], decision="allow")
prefix_rule(pattern=["npx", "vitest"], decision="allow")
prefix_rule(pattern=["npx", "tsc"], decision="allow")
prefix_rule(pattern=["npx", "vue-tsc"], decision="allow")
prefix_rule(pattern=["npx", "eslint"], decision="allow")
prefix_rule(pattern=["npx", "oxlint"], decision="allow")
prefix_rule(pattern=["npx", "prettier"], decision="allow")
prefix_rule(pattern=["npx", "oxfmt"], decision="allow")
prefix_rule(pattern=["npx", "nuxt"], decision="allow")
prefix_rule(pattern=["npx", "nuxi"], decision="allow")

# ── python toolchain ───────────────────────────────────────────────────
prefix_rule(pattern=["uv"], decision="allow")
prefix_rule(pattern=["uv", "run", "ruff", "check"], decision="allow")
prefix_rule(pattern=["uv", "run", "format"], decision="allow")
prefix_rule(pattern=["uvx"], decision="allow")
prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["python", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["python", "-m", "mypy"], decision="allow")
prefix_rule(pattern=["python3", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["python3", "-m", "mypy"], decision="allow")
prefix_rule(pattern=["ruff"], decision="allow")
prefix_rule(pattern=["mypy"], decision="allow")
prefix_rule(pattern=["pre-commit"], decision="allow")
prefix_rule(pattern=["prek"], decision="allow")
prefix_rule(pattern=["pip", "install"], decision="allow")
prefix_rule(pattern=["pip", "show"], decision="allow")
prefix_rule(pattern=["pip", "list"], decision="allow")
prefix_rule(pattern=["pip", "check"], decision="allow")
prefix_rule(pattern=["pip", "tree"], decision="allow")

# ── k8s (read-only verbs) ──────────────────────────────────────────────
prefix_rule(pattern=["kubectl", "get"], decision="allow")
prefix_rule(pattern=["kubectl", "logs"], decision="allow")
prefix_rule(pattern=["kubectl", "describe"], decision="allow")
prefix_rule(pattern=["kubectl", "top"], decision="allow")
prefix_rule(pattern=["kubectl", "explain"], decision="allow")
prefix_rule(pattern=["kubectl", "version"], decision="allow")
prefix_rule(pattern=["kubectl", "config", "current-context"], decision="allow")
prefix_rule(pattern=["helm", "lint"], decision="allow")
prefix_rule(pattern=["helm", "template"], decision="allow")
prefix_rule(pattern=["helm", "list"], decision="allow")
prefix_rule(pattern=["helm", "get"], decision="allow")
prefix_rule(pattern=["helm", "status"], decision="allow")
prefix_rule(pattern=["helm", "history"], decision="allow")

# ── misc read-only / harmless ──────────────────────────────────────────
prefix_rule(pattern=["cd"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["whereis"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["fd"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["tr"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["xargs"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["df"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["uname"], decision="allow")
prefix_rule(pattern=["id"], decision="allow")
prefix_rule(pattern=["whoami"], decision="allow")
prefix_rule(pattern=["column"], decision="allow")
prefix_rule(pattern=["realpath"], decision="allow")
prefix_rule(pattern=["dirname"], decision="allow")
prefix_rule(pattern=["basename"], decision="allow")
prefix_rule(pattern=["trash"], decision="allow")
