foreground = "#d8dee9"
background = "#2e3440"
background-opacity = 0.95

# # white configuration for screenshots:
# foreground="000000"
# background="ffffff"
# background-opacity=0.95

font-family = "Hack Nerd Font Mono"
font-size = 18
font-feature = -calt
adjust-cell-width = "-5%"

cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor

mouse-hide-while-typing = true

theme = "nord"

window-padding-x = 10

macos-titlebar-style = "hidden"
window-decoration = "none"
window-show-tab-bar = never

keybind = cmd+enter=text:\x0D

# https://github.com/ghostty-org/ghostty/discussions/3151
keybind = ctrl+enter=text:\r

# -- disable cmd+, opening the config file
keybind = super+,=unbind

# Workaround for Ghostty 1.3.1 encoding shift+enter as shift+tab (27;2;9~) in
# its modifyOtherKeys path, which breaks shift+enter inside tmux. Send the
# CSI-u shift+enter sequence directly: TUIs (pi, claude code) accept it in any
# keyboard-protocol mode, and tmux re-encodes it correctly for inner apps.
keybind = shift+enter=text:\x1b[13;2u

# -- disable cmd+t opening new tabs
keybind = super+t=unbind

# -- fix option
macos-option-as-alt = false
